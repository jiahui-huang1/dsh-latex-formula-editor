{
  "name": "dsh-latex-formula-editor",
  "version": "1.2.0",
  "type": "module",
  "description": "LaTeX formula editor for the DSH sidebar: offline MathJax rendering, symbol tiles, templates, favourites, OCR and multi-format export",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "vendor/",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs/img/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "latex",
    "mathjax",
    "formula-editor",
    "ocr"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiahui-huang1/dsh-latex-formula-editor.git"
  },
  "homepage": "https://github.com/jiahui-huang1/dsh-latex-formula-editor#readme",
  "bugs": {
    "url": "https://github.com/jiahui-huang1/dsh-latex-formula-editor/issues"
  }
}
