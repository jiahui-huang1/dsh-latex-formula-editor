{
  "name": "dsh-latex-formula-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Free and open-source LaTeX formula workbench in the DSH sidebar: visual editing, symbol palette, formula/image/PDF recognition and multi-format export.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "vendor/**",
    "docs/**",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
